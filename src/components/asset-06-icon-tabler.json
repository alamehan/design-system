  "usage": {
    "generic": "Icon(name='search', color='system.text-body', size=24)",
    "implementation": "Use the Tabler Icons package (@tabler/icons-react, @tabler/icons-vue, or SVG sprite). Icon name maps directly to the Tabler Icons library. Color is set via CSS `color` or `stroke` property.",
    "notes": "For icons not in this set, check Icon(Tabler Extended) (C5-07). The stroke color inherits from CSS — set color via the parent or a className."
  },
  "a11y": {
    "role": "img",
    "aria": {
      "aria-hidden": "true — when used decoratively alongside text",
      "aria-label": "[action description] — when used as the only indicator (e.g. IconButton)"
    }
  },
  "guidelines": {
    "do": [
      "Use inherit color so the icon automatically adapts to its context.",
      "Always pair with a visible label or aria-label.",
      "Use size=16 for small contexts (labels, chips), size=24 for standard, size=32 for empty states."
    ],
    "dont": [
      "Don't hardcode hex colors on icons — use semantic token references.",
      "Don't use for logos or illustrations — use Icon(Custom) or CharacterExpression instead."
    ]
