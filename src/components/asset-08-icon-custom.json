  "anatomy": {
    "root": {
      "element": "svg",
      "role": "img"
    },
    "paths": {
      "element": "path|rect|circle",
      "optional": false
    }
  },
  "usage": {
    "generic": "CustomIcon(name='dashboard', isActive=false)",
    "notes": "Unlike Tabler icons, Custom icons have colors built into the SVG. Don't apply CSS color overrides. For navigation: toggle between 'name' and 'name-active' based on route. Export as SVG from Figma — each variant is a separate SVG file."
  },
  "a11y": {
    "role": "img",
    "aria": {
      "aria-hidden": "true when used in Sidebar with visible label",
      "aria-label": "[navigation item name] when no adjacent label"
    }
  },
  "guidelines": {
    "do": [
      "Use dashboard/dashboard-active pair for sidebar navigation items.",
      "Use system-* icons for inline status indicators alongside text.",
      "Use filetype-* icons in file lists to show document format."
    ],
    "dont": [
      "Don't apply CSS color overrides — colors are baked into the custom icons.",
      "Don't use social icons without a social media context."
    ]
  },
