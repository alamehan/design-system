{
  "_schema": "elabram-component-v1",
  "id": "consent-toast",
  "name": "ConsentToast",
  "figmaName": "[🧱]-toast-for-consent",
  "figmaNodeId": "7237:147093",
  "category": "advanced",
  "section": "Advanced Components",
  "role": "component",
  "implementable": true,
  "description": "Domain-specific toast for data consent notifications. Three copywriting variants with different messaging. Copywriting 1 & 2 use Warning style; Copywriting 3 uses Error style. Built on top of Toast(Filled). Includes action buttons for consent response.",
  "props": {
    "type": {
      "type": "enum",
      "values": [
        "Copywriting1",
        "Copywriting2",
        "Copywriting3"
      ],
      "default": "Copywriting1"
    }
  },
  "tokens": {
    "base": {
      "radius": "corner-radius.lg",
      "padding-y": "spacing.standard.sm",
      "padding-x": "spacing.standard.lg",
      "gap": "spacing.standard.lg",
      "border-width": "stroke.thin"
    },
    "overrides": [
      {
        "when": {
          "type": [
            "Copywriting1",
            "Copywriting2"
          ]
        },
        "tokens": {
          "background": "semantic.warning-surface-soft",
          "border-color": "semantic.warning"
        }
      },
      {
        "when": {
          "type": "Copywriting3"
        },
        "tokens": {
          "background": "semantic.error-surface-soft",
          "border-color": "semantic.error"
        }
      }
    ]
  },
  "subcomponents": [
    "toast",
    "button"
  ],
  "anatomy": {
    "root": {
      "element": "div",
      "role": "alert"
    },
    "icon": {
      "element": "span"
    },
    "content": {
      "element": "div",
      "note": "Title + description text"
    },
    "actions": {
      "element": "div",
      "note": "Consent action buttons (Accept, Decline, View)"
    }
  },
  "usage": {
    "generic": "ConsentToast(type='Copywriting1')",
    "notes": "Display when candidate consent is pending or requires action. Use persistent (duration=0) so user must respond."
  },
  "a11y": {
    "role": "alert",
    "aria": {
      "aria-live": "assertive",
      "aria-atomic": "true"
    }
  },
  "guidelines": {
    "do": [
      "Always persist this toast until user responds — do not auto-dismiss.",
      "Show only one ConsentToast at a time."
    ],
    "dont": [
      "Don't use for generic notifications — use Toast instead."
    ]
  },
  "code": "composite-10"
}